        <!-- Note: DTD cannot enforce the XSD's implicit requirement of "at least one of each" of waveform, timing, etc. in any order. -->
        <!-- This model enforces that parameters is present, followed by at least one of the other main elements, preserving flexible ordering. -->
        <!ELEMENT simulation (parameters, (waveform | timing | antenna | mesh | material | platform | include)+)>
        <!ATTLIST simulation name CDATA #REQUIRED>

        <!-- Simulation Parameters -->
        <!ELEMENT parameters (starttime,endtime,rate,c?,simSamplingRate?,cwSimSamplingRate?,randomseed?,adc_bits?,oversample?,rotationangleunit?,origin?,coordinatesystem?,propagation?)>
        <!-- Start time of simulation -->
        <!ELEMENT starttime (#PCDATA)>
        <!-- End time of simulation -->
        <!ELEMENT endtime (#PCDATA)>
        <!-- Propagation speed -->
        <!ELEMENT c (#PCDATA)>
        <!-- Fidelity of the underlying physics simulation for pulsed waveforms (Hz) -->
        <!ELEMENT simSamplingRate (#PCDATA)>
        <!-- Fidelity of the underlying physics simulation for CW waveforms (Hz) -->
        <!ELEMENT cwSimSamplingRate (#PCDATA)>
        <!-- Override the rendering sample rate with the specified one (Hz) -->
        <!ELEMENT rate (#PCDATA)>
        <!-- Random seed for noise -->
        <!ELEMENT randomseed (#PCDATA)>
        <!-- ADC bits for resolution -->
        <!ELEMENT adc_bits (#PCDATA)>
        <!-- Oversampling factor -->
        <!ELEMENT oversample (#PCDATA)>
        <!-- Rotation angle unit for external interfaces -->
        <!ELEMENT rotationangleunit (#PCDATA)>
        <!-- Geodetic origin used only for ENU KML/geospatial export -->
        <!ELEMENT origin EMPTY>
        <!ATTLIST origin
                latitude  CDATA #REQUIRED
                longitude CDATA #REQUIRED
                altitude  CDATA "0"
                >
        <!-- Coordinate system used only for KML/geospatial export -->
        <!ELEMENT coordinatesystem EMPTY>
        <!ATTLIST coordinatesystem
                frame      (ENU|UTM|ECEF) #REQUIRED
                zone       CDATA          #IMPLIED
                hemisphere (N|S)          #IMPLIED
                >
        <!-- Selects the propagation model and sets model-specific parameters. -->
        <!ELEMENT propagation (pointscatter|raytracing)>
        <!ELEMENT pointscatter EMPTY>
        <!ATTLIST pointscatter
                polarimetric (true|false) "false"
                >
        <!ELEMENT raytracing EMPTY>
        <!ATTLIST raytracing
                scatter_limit                  CDATA #IMPLIED
                boresight_width                CDATA #IMPLIED
                boresight_tube_solid_angle     CDATA #IMPLIED
                off_boresight_tube_solid_angle CDATA #IMPLIED
                prune_below_max_db             CDATA #IMPLIED
                >

        <!-- Waveform definition -->
        <!ELEMENT waveform (power, carrier_frequency, (pulsed_from_file | cw_from_file | fmcw_from_file | cw | fmcw_linear_chirp | fmcw_triangle | stepped_frequency))>
        <!ATTLIST waveform
                name CDATA #REQUIRED>

        <!-- Waveform power and carrier frequency -->
        <!-- Pulse power (Watts) -->
        <!ELEMENT power (#PCDATA)>
        <!-- Carrier frequency (Hz) -->
        <!ELEMENT carrier_frequency (#PCDATA)>

        <!-- Waveform types -->
        <!ELEMENT pulsed_from_file EMPTY>
        <!ATTLIST pulsed_from_file filename CDATA #REQUIRED>
        <!ELEMENT cw_from_file EMPTY>
        <!ATTLIST cw_from_file filename CDATA #REQUIRED>
        <!ELEMENT fmcw_from_file EMPTY>
        <!ATTLIST fmcw_from_file filename CDATA #REQUIRED>
        <!ELEMENT cw EMPTY>
        <!ELEMENT fmcw_linear_chirp (chirp_bandwidth, chirp_duration, chirp_period, start_frequency_offset?, chirp_count?)>
        <!ATTLIST fmcw_linear_chirp direction (up|down) #REQUIRED>
        <!ELEMENT fmcw_triangle (chirp_bandwidth, chirp_duration, start_frequency_offset?, triangle_count?)>
        <!ELEMENT stepped_frequency (start_frequency_offset, step_size, step_count, dwell_time, step_period, sweep_count?)>
        <!ELEMENT chirp_bandwidth (#PCDATA)>
        <!ELEMENT chirp_duration (#PCDATA)>
        <!ELEMENT chirp_period (#PCDATA)>
        <!ELEMENT start_frequency_offset (#PCDATA)>
        <!ELEMENT step_size (#PCDATA)>
        <!ELEMENT step_count (#PCDATA)>
        <!ELEMENT dwell_time (#PCDATA)>
        <!ELEMENT step_period (#PCDATA)>
        <!ELEMENT sweep_count (#PCDATA)>
        <!-- Per-schedule-segment maximum chirp count; each scheduled period may emit up to this many chirps. -->
        <!ELEMENT chirp_count (#PCDATA)>
        <!-- Per-schedule-segment maximum full triangle count; each scheduled period may emit up to this many triangles. -->
        <!ELEMENT triangle_count (#PCDATA)>

        <!-- Timing Source -->
        <!ELEMENT timing (frequency,freq_offset?,random_freq_offset_stdev?,phase_offset?,random_phase_offset_stdev?,noise_entry*)>
        <!-- Timing source. Sets frequency -->
        <!ATTLIST timing
                name CDATA #REQUIRED
                synconpulse (true|false) "false">

        <!-- Frequency (Hz) -->
        <!ELEMENT frequency (#PCDATA)>

        <!-- Noise Entry for timing -->
        <!ELEMENT noise_entry (alpha,weight)>
        <!-- Noise category alpha -->
        <!ELEMENT alpha (#PCDATA)>
        <!-- Weighting of noise in the category -->
        <!ELEMENT weight (#PCDATA)>
        <!-- Offset from system frequency -->
        <!ELEMENT freq_offset (#PCDATA)>
        <!-- Random frequency offset standard deviation -->
        <!ELEMENT random_freq_offset_stdev (#PCDATA)>
        <!-- Phase offset -->
        <!ELEMENT phase_offset (#PCDATA)>
        <!-- Random phase offset standard deviation -->
        <!ELEMENT random_phase_offset_stdev (#PCDATA)>

        <!-- Antenna -->
        <!ELEMENT antenna (alpha?,beta?,gamma?,diameter?,azscale?,elscale?,efficiency?,
                          boresight_polarisation?)>
        <!ATTLIST antenna
                name CDATA #REQUIRED
                pattern CDATA #REQUIRED
                filename CDATA #IMPLIED>

        <!-- Parameters of antenna model -->
        <!-- Element for beta -->
        <!ELEMENT beta (#PCDATA)>
        <!-- Element for gamma -->
        <!ELEMENT gamma (#PCDATA)>
        <!-- Diameter of the antenna -->
        <!ELEMENT diameter (#PCDATA)>
        <!-- Azimuth scale for a Gaussian pattern -->
        <!ELEMENT azscale (#PCDATA)>
        <!-- Elevation scale for Gaussian pattern -->
        <!ELEMENT elscale (#PCDATA)>
        <!-- The antenna efficiency factor -->
        <!ELEMENT efficiency (#PCDATA)>
        <!-- Boresight polarisation Jones vector (Ludwig-3). h/v each hold a complex number as
             text, e.g. "1.0+0.0i" (also accepts a leading unit marker, a bare real or imaginary
             term, and "j" as well as "i"). Defaults to purely horizontal if omitted. -->
        <!ELEMENT boresight_polarisation EMPTY>
        <!ATTLIST boresight_polarisation
                h CDATA #IMPLIED
                v CDATA #IMPLIED>

        <!-- Mesh Asset: a reusable mesh, loaded from a file within the "meshes" directory next to the scenario file -->
        <!ELEMENT mesh EMPTY>
        <!ATTLIST mesh
                name CDATA #REQUIRED
                filename CDATA #REQUIRED>

        <!-- Material Asset: a reusable surface material for ray-tracing propagation. Conductivity
             may be "inf" to specify a perfect electric conductor. -->
        <!ELEMENT material (relative_permittivity,conductivity)>
        <!ATTLIST material
                name CDATA #REQUIRED>
        <!ELEMENT relative_permittivity (#PCDATA)>
        <!ELEMENT conductivity (#PCDATA)>

        <!-- Platform -->
        <!ELEMENT platform (motionpath,(rotationpath|fixedrotation),(monostatic|transmitter|receiver|target)*)>
        <!ATTLIST platform
                name CDATA #REQUIRED>

        <!-- Motion paths and Position Waypoints -->
        <!ELEMENT motionpath (positionwaypoint+)>
        <!ATTLIST motionpath interpolation (static|linear|cubic) "static">

        <!-- Position Waypoints -->
        <!ELEMENT positionwaypoint (x,y,altitude,time)>
        <!-- x position of waypoint -->
        <!ELEMENT x (#PCDATA)>
        <!-- y position of waypoint -->
        <!ELEMENT y (#PCDATA)>
        <!-- z (altitude) position of waypoint -->
        <!ELEMENT altitude (#PCDATA)>
        <!-- Time the platform is at the waypoint -->
        <!ELEMENT time (#PCDATA)>

        <!-- Constant Rate Rotation -->
        <!ELEMENT fixedrotation (startazimuth,startelevation,azimuthrate,elevationrate)>
        <!-- Azimuth at time 0 -->
        <!ELEMENT startazimuth (#PCDATA)>
        <!-- Elevation at time 0 -->
        <!ELEMENT startelevation (#PCDATA)>
        <!-- Rate of change of azimuth -->
        <!ELEMENT azimuthrate (#PCDATA)>
        <!-- Rate of change of elevation -->
        <!ELEMENT elevationrate (#PCDATA)>

        <!-- Rotation Paths and Waypoints -->
        <!ELEMENT rotationpath (rotationwaypoint+)>
        <!ATTLIST rotationpath interpolation (static|linear|cubic) #REQUIRED>
        <!ELEMENT rotationwaypoint (azimuth,elevation,time)>
        <!ELEMENT azimuth (#PCDATA)>
        <!ELEMENT elevation (#PCDATA)>

        <!-- Elements for defining radar operational modes -->
        <!ELEMENT pulsed_mode (prf, window_skip?, window_length?)>
        <!ELEMENT cw_mode EMPTY>
        <!ELEMENT fmcw_mode (dechirp_reference?, if_sample_rate?, if_filter_bandwidth?, if_filter_transition_width?)>
        <!ATTLIST fmcw_mode dechirp_mode (none|physical|ideal) "none">
        <!ELEMENT sfcw_mode EMPTY>
        <!ELEMENT dechirp_reference EMPTY>
        <!ATTLIST dechirp_reference
                source (attached|transmitter|custom) #REQUIRED
                transmitter_name CDATA #IMPLIED
                waveform_name CDATA #IMPLIED
                >
        <!ELEMENT if_sample_rate (#PCDATA)>
        <!ELEMENT if_filter_bandwidth (#PCDATA)>
        <!ELEMENT if_filter_transition_width (#PCDATA)>

        <!ELEMENT schedule (period+)>
        <!ELEMENT period EMPTY>
        <!ATTLIST period
                start CDATA #REQUIRED
                end CDATA #REQUIRED
                >

        <!-- Monostatic radar installations -->
        <!ELEMENT monostatic ((pulsed_mode | cw_mode | fmcw_mode | sfcw_mode), noise_temp?, schedule?)>
        <!ATTLIST monostatic
                name CDATA #REQUIRED
                antenna CDATA #REQUIRED
                waveform CDATA #REQUIRED
                timing CDATA #REQUIRED
                nodirect (true|false) "false"
                nopropagationloss (true|false) "false">
        <!ELEMENT prf (#PCDATA)>
        <!ELEMENT noise_temp (#PCDATA)>

        <!-- Standalone Transmitter -->
        <!ELEMENT transmitter ((pulsed_mode | cw_mode | fmcw_mode | sfcw_mode), schedule?)>
        <!ATTLIST transmitter
                name CDATA #REQUIRED
                waveform CDATA #REQUIRED
                antenna CDATA #REQUIRED
                timing CDATA #REQUIRED>

        <!-- Standalone Receiver -->
        <!ELEMENT receiver ((pulsed_mode | cw_mode | fmcw_mode | sfcw_mode), noise_temp?, schedule?)>
        <!ATTLIST receiver
                name CDATA #REQUIRED
                antenna CDATA #REQUIRED
                timing CDATA #REQUIRED
                nodirect (true|false) "false"
                nopropagationloss (true|false) "false">
        <!-- Time to skip after start of pulse before starting receiving (seconds) -->
        <!ELEMENT window_skip (#PCDATA)>
        <!-- Length of the range gate (seconds) -->
        <!ELEMENT window_length (#PCDATA)>

        <!-- Target -->
        <!ELEMENT target (rcs?,model?,geometry?)>
        <!ATTLIST target
                name CDATA #REQUIRED>

        <!-- Target Geometry: references a mesh/material pair for ray-tracing propagation -->
        <!ELEMENT geometry EMPTY>
        <!ATTLIST geometry
                mesh CDATA #REQUIRED
                material CDATA #REQUIRED>

        <!-- RCS can either have a 'value' element or a 'filename' attribute -->
        <!-- Target RCS -->
        <!ELEMENT rcs (value?)>
        <!ATTLIST rcs type CDATA #REQUIRED
                filename CDATA #IMPLIED>

        <!-- RCS value -->
        <!ELEMENT value (#PCDATA)>

        <!-- Model element with 'type' as an attribute and optional k element -->
        <!ELEMENT model (k?)>
        <!ATTLIST model type CDATA #REQUIRED>
        <!ELEMENT k (#PCDATA)>

        <!-- Include another XML file -->
        <!ELEMENT include (#PCDATA)>
